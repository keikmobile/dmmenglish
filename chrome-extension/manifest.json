{
  "manifest_version": 3,
  "name": "DMM英会話 今すぐ予約",
  "version": "1.2.0",
  "description": "直近の予約可能スロットをワンクリック／ショートカットで検索",
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "DMM英会話 今すぐ予約"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{
    "matches": ["https://eikaiwa.dmm.com/dashboard*", "https://eikaiwa.dmm.com/list/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "permissions": [
    "tabs",
    "windows"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "DMM英会話 今すぐ予約を開く"
    }
  }
}
